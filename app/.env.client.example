REACT_APP_FAMILY_PORTAL_HOST=familia.localhost

# Web Push (optional) — chave pública VAPID
REACT_APP_VAPID_PUBLIC_KEY=

# Himetrica Analytics (optional)
REACT_APP_HIMETRICA_API_KEY=hm_d614af33452c01d2b95d63e72fc7b850d9a7977f016bcb2e