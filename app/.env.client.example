# All client-side env vars must start with REACT_APP_ https://wasp.sh/docs/project/env-vars

# See https://docs.opensaas.sh/guides/analytics/#google-analytics
REACT_APP_GOOGLE_ANALYTICS_ID=G-...

# ── Family Portal (subdomínio familia.*) ─────────────────────────────────
# Hostname do portal da família. Em dev local: familia.localhost
# Produção: familia.catechis.app
REACT_APP_FAMILY_PORTAL_HOST=familia.localhost
REACT_APP_STAFF_PORTAL_HOST=localhost

# Web Push (optional) — chave pública VAPID
REACT_APP_VAPID_PUBLIC_KEY=

# Himetrica Analytics (optional)
REACT_APP_HIMETRICA_API_KEY=hm_d614af33452c01d2b95d63e72fc7b850d9a7977f016bcb2e
# Google Tag Manager (optional)
REACT_APP_GTM_ID=GTM-XXXXXXX

# Meta Pixel (optional native browser pixel — same ID as META_PIXEL_ID on the server)
# When set, the app loads fbq and mirrors standard Meta events with event_id for CAPI dedup.
# GTM can still fire the same Pixel; keep IDs identical and rely on event_id matching.
REACT_APP_META_PIXEL_ID=

