# ══════════════════════════════════════════════════════════════════════════════
# PRODUÇÃO: Verifique e configure todas as variáveis abaixo antes do deploy.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────
# Em desenvolvimento, use `wasp start db` e NÃO defina DATABASE_URL.
# Em produção, configure a URL de conexão do PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# Adicione parâmetros de pool para limitar conexões:
#   local:           ?connection_limit=5&pool_timeout=20
#   homolog (Aiven): ?connection_limit=2&pool_timeout=20&sslmode=require&uselibpqcompat=true
#   prod pequena:    ?connection_limit=5&pool_timeout=20&sslmode=require&uselibpqcompat=true
#
# Migrations (prisma migrate deploy) usam conexão direta, sem pool.

# ── JWT Secret (CRÍTICO para produção) ────────────────────────────────────
# Gere com: openssl rand -base64 64
# Em desenvolvimento, o Wasp gera um automaticamente.
JWT_SECRET=your-jwt-secret-here

# ── URLs da Aplicação ──────────────────────────────────────────────────────
# Produção:
# WASP_WEB_CLIENT_URL=https://catechis.app
# WASP_SERVER_URL=https://api.catechis.app
# Homolog:
# WASP_WEB_CLIENT_URL=https://homolog.catechis.app
# WASP_SERVER_URL=https://api-homolog.catechis.app

# ── Family Portal (subdomínio familia.*) ─────────────────────────────────
# Domínio do cookie de sessão (com ponto inicial) para partilhar sessão entre
# catechis.app e familia.catechis.app.
# Produção: COOKIE_DOMAIN=.catechis.app
# Homolog:  COOKIE_DOMAIN=.catechis.app  (familia-homolog + homolog; JWT homolog ≠ prod)
# Dev local: não definir (localhost não suporta subdomínios com cookie domain)
# COOKIE_DOMAIN=.catechis.app
FAMILY_PORTAL_HOST=familia.catechis.app
STAFF_PORTAL_HOST=catechis.app

# ── Manutenção diária (produção/homolog; mínimo de 32 caracteres) ──────────
# MAINTENANCE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
#

# ── Bunny.net Storage ───────────────────────────────────────────────────────
# BUNNY_STORAGE_ZONE=catechis-prod
# BUNNY_STORAGE_API_KEY=
# BUNNY_STORAGE_HOSTNAME=ny.storage.bunnycdn.com
# Pull zone que serve as imagens públicas da Comunidade. Sem ela, as imagens
# são servidas por /api/social/media/:mediaId (funciona, mas sem CDN).
# BUNNY_CDN_HOSTNAME=cdn.catechis.app

# ── Bunny Stream (vídeos da Comunidade) ─────────────────────────────────────
# Sem estas variáveis o envio de vídeo fica desativado; imagens continuam a
# funcionar normalmente.
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# Pull zone da biblioteca de vídeo (usada para thumbnails).
# BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx.b-cdn.net
# Token adicionado à URL do webhook configurado no painel do Bunny:
# https://<app>/api/social/bunny-webhook?token=<valor>
# BUNNY_STREAM_WEBHOOK_TOKEN=

# ── Sentry (opcional) ───────────────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# ── Email (Resend: SMTP só para auth Wasp + API para o restante) ──────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxx
# RESEND_WEBHOOK_SECRET=
# EMAIL_PROVIDER=resend
# EMAIL_FROM_NAME=Catequese Viva
# EMAIL_FROM_TRANSACTIONAL=noreply@catechis.app
# EMAIL_FROM_LIFECYCLE=updates@catechis.app
# EMAIL_FROM_PASTORAL=comunicados@catechis.app
# EMAIL_FROM_MARKETING=hello@catechis.app
# EMAIL_DEFAULT_LOCALE=pt-BR

# ── Payment (Stripe) ──────────────────────────────────────────────────────
# Teste: https://dashboard.stripe.com/test/apikeys (chave começa com sk_test_)
# Produção: https://dashboard.stripe.com/apikeys (chave começa com sk_live_)
STRIPE_API_KEY=sk_test_...
# After downloading starting the stripe cli (https://stripe.com/docs/stripe-cli) with `stripe listen --forward-to localhost:3001/payments-webhook` it will output your signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# For testing, create a new store in test mode on https://lemonsqueezy.com.
LEMONSQUEEZY_API_KEY=eyJ...
# After creating a store, you can find your store id in the store settings https://app.lemonsqueezy.com/settings/stores.
LEMONSQUEEZY_STORE_ID=012345
# define your own webhook secret when creating a new webhook on https://app.lemonsqueezy.com/settings/webhooks.
LEMONSQUEEZY_WEBHOOK_SECRET=my-webhook-secret

# Generate a token at https://sandbox.polar.sh/dashboard/[your-org-slug]/settings.
POLAR_ORGANIZATION_ACCESS_TOKEN=polar_oat_...
# Define your own webhook secret when creating a new webhook at https://sandbox.polar.sh/dashboard/[your-org-slug]/settings/webhooks.
POLAR_WEBHOOK_SECRET=polar_whs_...
# For production, set this to false, make sure to generate production organization and products.
POLAR_SANDBOX_MODE=true

# Create each Product/Price (currency BRL) in the Stripe Dashboard:
# https://dashboard.stripe.com/test/products  →  + Add Product
# then paste the resulting Price ID (starts with `price_`) below.

# Plano Único — personal
STRIPE_SINGLE_PLAN_ID=price_...
STRIPE_SINGLE_ANNUAL_PLAN_ID=price_...
# Plano Ilimitado — institutional
STRIPE_UNLIMITED_PLAN_ID=price_...
STRIPE_UNLIMITED_ANNUAL_PLAN_ID=price_...
# AI credit packs (one-time purchase, BRL)
STRIPE_AI_CREDITS_20_PLAN_ID=price_...
STRIPE_AI_CREDITS_50_PLAN_ID=price_...
# db (default) = /admin/planos. static = ignore admin and use DEFAULT_PLANS.
PRICING_CATALOG_SOURCE=db



# ── Meta Conversions API (optional in dev, required in production for server-side conversion events) ──
META_PIXEL_ID=123456789012345
META_CAPI_ACCESS_TOKEN=EAAB...
META_GRAPH_VERSION=v23.0
# Optional test code from Meta Events Manager
META_TEST_EVENT_CODE=
# Set this as a comma-separated list of emails you want to give admin privileges to upon registeration.
ADMIN_EMAILS=me@example.com,you@example.com,them@example.com

# See our guide for setting up google auth: https://wasp.sh/docs/auth/social-auth/google.
GOOGLE_CLIENT_ID=722...
GOOGLE_CLIENT_SECRET=GOC...

# (OPTIONAL) Get your openai api key at https://platform.openai.com/account.
OPENAI_API_KEY=sk-k...
# Alternative AI providers (at least one required for AI features):
DEEPSEEK_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
# AI provider to use: openai (default), deepseek, or openrouter
AI_PROVIDER=openai
# Override default model (optional):
# AI_MODEL=gpt-4o

# Optional leftover Open SaaS keys. Daily stats use first-party Postgres data
# (users, PricingEvent activity, Stripe revenue). Not required for boot.
# PLAUSIBLE_API_KEY=
# PLAUSIBLE_SITE_ID=
# PLAUSIBLE_BASE_URL=https://plausible.io/api

# Optional Google Analytics. Not used by daily stats.
# GOOGLE_ANALYTICS_CLIENT_EMAIL=
# GOOGLE_ANALYTICS_PRIVATE_KEY=
# GOOGLE_ANALYTICS_PROPERTY_ID=

# (OPTIONAL) Get your aws s3 credentials at https://console.aws.amazon.com and create a new IAM user with S3 access.
AWS_S3_IAM_ACCESS_KEY=ACK...
AWS_S3_IAM_SECRET_KEY=t+33a...
AWS_S3_FILES_BUCKET=your-bucket-name
AWS_S3_REGION=your-region
