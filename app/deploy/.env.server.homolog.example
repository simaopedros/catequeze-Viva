# Homolog — copie para .env.server no VPS de homologação

DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/catequese_homolog?sslmode=require

JWT_SECRET=

WASP_WEB_CLIENT_URL=https://homolog.catechis.app
WASP_SERVER_URL=https://api-homolog.catechis.app

# Partilha sessão entre homolog.catechis.app e familia-homolog.catechis.app (JWT homolog ≠ prod)
COOKIE_DOMAIN=.catechis.app
FAMILY_PORTAL_HOST=familia-homolog.catechis.app
STAFF_PORTAL_HOST=homolog.catechis.app

RUN_JOBS=false

BUNNY_STORAGE_ZONE=catechis-homolog
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=

STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

SENTRY_DSN=
SENTRY_ENVIRONMENT=homolog

ENABLE_PRICING_V2=true
PRICING_ROLLOUT_PERCENTAGE=100

ADMIN_EMAILS=dev@catechis.app

# Google OAuth (obrigatório no boot — use credenciais reais para login Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Analytics admin (obrigatório no boot — placeholders impedem crash; troque por credenciais reais)
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=homolog.catechis.app
PLAUSIBLE_BASE_URL=https://plausible.io/api
GOOGLE_ANALYTICS_CLIENT_EMAIL=
GOOGLE_ANALYTICS_PRIVATE_KEY=
GOOGLE_ANALYTICS_PROPERTY_ID=

# Pagamentos legacy (obrigatório no boot — placeholders até configurar provedores reais)
PAYMENTS_HOBBY_SUBSCRIPTION_PLAN_ID=homolog-hobby
PAYMENTS_PRO_SUBSCRIPTION_PLAN_ID=homolog-pro
PAYMENTS_CREDITS_10_PLAN_ID=homolog-credits
LEMONSQUEEZY_API_KEY=homolog-placeholder
LEMONSQUEEZY_STORE_ID=homolog-store
LEMONSQUEEZY_WEBHOOK_SECRET=homolog-webhook
POLAR_ORGANIZATION_ACCESS_TOKEN=homolog-polar-token
POLAR_SANDBOX_MODE=true
POLAR_WEBHOOK_SECRET=homolog-polar-webhook
