# Homolog — copie para .env.server no VPS de homologação

DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/catequese_homolog?sslmode=require

JWT_SECRET=

WASP_WEB_CLIENT_URL=https://homolog.catechis.app
WASP_SERVER_URL=https://api-homolog.catechis.app

# Partilha sessão entre homolog.catechis.app e familia-homolog.catechis.app (JWT homolog ≠ prod)
COOKIE_DOMAIN=.catechis.app
FAMILY_PORTAL_HOST=familia-homolog.catechis.app
STAFF_PORTAL_HOST=homolog.catechis.app

MAINTENANCE_SECRET=replace-with-a-random-secret-of-at-least-32-characters

BUNNY_STORAGE_ZONE=catechis-homolog
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
# Pull zone das imagens/vídeos da Comunidade no Storage. Sem ela, o player
# usa /api/social/media/:mediaId.
# BUNNY_CDN_HOSTNAME=

# Bunny Stream (opcional na homologação). Sem isto o compositor envia o
# vídeo para o Storage acima (até 60 MB) em vez do TUS da Stream.
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx.b-cdn.net
# BUNNY_STREAM_WEBHOOK_TOKEN=

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL=noreply@catechis.app
EMAIL_FROM_LIFECYCLE=updates@catechis.app
EMAIL_FROM_PASTORAL=comunicados@catechis.app
EMAIL_FROM_MARKETING=hello@catechis.app

STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Opcional: após falha de webhook, o deploy homolog reconcilia Stripe → User automaticamente
# BILLING_RECONCILE_EMAIL=

# Pricing v2 — crie Products/Prices em https://dashboard.stripe.com/test/products (USD, recurring)
# e cole cada Price ID (price_...) abaixo. Sem isto o checkout devolve parameter_invalid_empty.
# LANÇAMENTO: Durante a fase de lançamento, apenas o Plano Único (R$ 9,90) está disponível.
# Configure STRIPE_SINGLE_PLAN_ID com o Price ID da Stripe (moeda BRL).
STRIPE_SINGLE_PLAN_ID=price_...
STRIPE_SINGLE_ANNUAL_PLAN_ID=price_...
# Plano Ilimitado não está em venda durante a fase de lançamento:
STRIPE_UNLIMITED_PLAN_ID=price_...
STRIPE_UNLIMITED_ANNUAL_PLAN_ID=price_...
STRIPE_AI_CREDITS_20_PLAN_ID=price_...
STRIPE_AI_CREDITS_50_PLAN_ID=price_...

SENTRY_DSN=
SENTRY_ENVIRONMENT=homolog

ENABLE_PRICING_V2=true
PRICING_ROLLOUT_PERCENTAGE=100

ADMIN_EMAILS=dev@catechis.app

# Google OAuth (obrigatório no boot — use credenciais reais para login Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Analytics admin (opcional — dailyStats usa dados first-party no Postgres)
# PLAUSIBLE_API_KEY=
# PLAUSIBLE_SITE_ID=homolog.catechis.app
# PLAUSIBLE_BASE_URL=https://plausible.io/api
# GOOGLE_ANALYTICS_CLIENT_EMAIL=
# GOOGLE_ANALYTICS_PRIVATE_KEY=
# GOOGLE_ANALYTICS_PROPERTY_ID=

# Pagamentos legacy (obrigatório no boot — placeholders até configurar provedores reais)
PAYMENTS_HOBBY_SUBSCRIPTION_PLAN_ID=homolog-hobby
PAYMENTS_PRO_SUBSCRIPTION_PLAN_ID=homolog-pro
PAYMENTS_CREDITS_10_PLAN_ID=homolog-credits
LEMONSQUEEZY_API_KEY=homolog-placeholder
LEMONSQUEEZY_STORE_ID=homolog-store
LEMONSQUEEZY_WEBHOOK_SECRET=homolog-webhook
POLAR_ORGANIZATION_ACCESS_TOKEN=homolog-polar-token
POLAR_SANDBOX_MODE=true
POLAR_WEBHOOK_SECRET=homolog-polar-webhook

# ── AI ─────────────────────────────────────────────────────────────────────
# Pelo menos um provider precisa de API key. O default é OpenAI.
# AI_PROVIDER: openai (default) | deepseek | openrouter
# AI_MODEL: override do modelo default do provider (opcional)
OPENAI_API_KEY=sk-proj-...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
