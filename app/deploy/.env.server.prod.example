# ══════════════════════════════════════════════════════════════════════════════
# PRODUÇÃO — copie para .env.server no VPS e preencha os valores reais.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database (Neon) ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/catequese?sslmode=require

# ── JWT Secret ──────────────────────────────────────────────────────────────
JWT_SECRET=

# ── URLs ────────────────────────────────────────────────────────────────────
WASP_WEB_CLIENT_URL=https://catechis.app
WASP_SERVER_URL=https://api.catechis.app

# ── Dual-portal ───────────────────────────────────────────────────────────────
COOKIE_DOMAIN=.catechis.app
FAMILY_PORTAL_HOST=familia.catechis.app
STAFF_PORTAL_HOST=catechis.app

# ── Process role (server container: false, worker container: true) ────────────
RUN_JOBS=false

# ── Bunny.net Storage ───────────────────────────────────────────────────────
BUNNY_STORAGE_ZONE=catechis-prod
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOSTNAME=ny.storage.bunnycdn.com

# ── Email (Resend SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=

# ── Stripe (live) ───────────────────────────────────────────────────────────
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Sentry (opcional) ───────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Pricing v2 ────────────────────────────────────────────────────────────────
ENABLE_PRICING_V2=true
PRICING_ROLLOUT_PERCENTAGE=100

# ── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
AI_PROVIDER=openai

ADMIN_EMAILS=admin@catechis.app
