# ══════════════════════════════════════════════════════════════════════════════
# PRODUÇÃO — copie para .env.server no VPS e preencha os valores reais.
# NUNCA commite o .env.server real. Este ficheiro deve conter apenas placeholders.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── JWT Secret (gere com: openssl rand -base64 64) ──────────────────────────
JWT_SECRET=replace-with-a-long-random-secret

# ── URLs ────────────────────────────────────────────────────────────────────
WASP_WEB_CLIENT_URL=https://catechis.app
WASP_SERVER_URL=https://api.catechis.app

# ── Dual-portal ───────────────────────────────────────────────────────────────
COOKIE_DOMAIN=.catechis.app
FAMILY_PORTAL_HOST=familia.catechis.app
STAFF_PORTAL_HOST=catechis.app

# ── Dev skip (produção: NÃO definir — email verification ativo) ───────────────
# SKIP_EMAIL_VERIFICATION_IN_DEV (NÃO definir em produção)

# ── Daily maintenance endpoint (generate a random value with 32+ chars) ──────
MAINTENANCE_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# ── Bunny.net Storage ───────────────────────────────────────────────────────
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_STORAGE_API_KEY=replace-with-bunny-storage-api-key
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
# Comunidade: pull zone das imagens públicas e biblioteca de vídeo (Bunny Stream)
BUNNY_CDN_HOSTNAME=cdn.catechis.app
BUNNY_STREAM_LIBRARY_ID=replace-with-stream-library-id
BUNNY_STREAM_API_KEY=replace-with-stream-api-key
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx.b-cdn.net
BUNNY_STREAM_WEBHOOK_TOKEN=replace-with-random-token

# ── Email (Resend SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxxxxx

# ── Stripe (live) ───────────────────────────────────────────────────────────
# Chaves: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# ── Stripe Plan IDs ────────────────────────────────────────────────────────────
STRIPE_CATECHIST_PRO_PLAN_ID=price_xxxxxxxx
STRIPE_CATECHIST_AI_PLAN_ID=price_xxxxxxxx
STRIPE_PARISH_ESSENTIAL_PLAN_ID=price_xxxxxxxx
STRIPE_PARISH_COMPLETE_PLAN_ID=price_xxxxxxxx
STRIPE_DIOCESE_PLAN_ID=price_xxxxxxxx
STRIPE_PARISH_PLAN_ID=price_xxxxxxxx
STRIPE_AI_CREDITS_20_PLAN_ID=price_xxxxxxxx
STRIPE_AI_CREDITS_50_PLAN_ID=price_xxxxxxxx

# ── Stripe Annual Plan IDs ──────────────────────────────────────────────────
STRIPE_CATECHIST_PRO_ANNUAL_PLAN_ID=price_xxxxxxxx
STRIPE_CATECHIST_AI_ANNUAL_PLAN_ID=price_xxxxxxxx
STRIPE_PARISH_ESSENTIAL_ANNUAL_PLAN_ID=price_xxxxxxxx
STRIPE_PARISH_COMPLETE_ANNUAL_PLAN_ID=price_xxxxxxxx
STRIPE_PARISH_ANNUAL_PLAN_ID=price_xxxxxxxx
STRIPE_DIOCESE_ANNUAL_PLAN_ID=price_xxxxxxxx

# ── Woovi (PIX) — opcional em produção ─────────────────────────────────────
# WOOVI_APP_ID=
# WOOVI_SANDBOX=false
# WOOVI_WEBHOOK_SECRET=
# WOOVI_PIX_MODE=simples

# ── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=https://EXAMPLE@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production

# ── Pricing v2 ────────────────────────────────────────────────────────────────
ENABLE_PRICING_V2=true
PRICING_ROLLOUT_PERCENTAGE=100

# ── AI ──────────────────────────────────────────────────────────────────────
# Pelo menos um provider precisa de API key. Nunca coloque chaves reais neste exemplo.
OPENAI_API_KEY=sk-proj-xxxxxxxx
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini

ADMIN_EMAILS=admin@catechis.app

# Google OAuth (obrigatório no boot)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Analytics admin (opcional — dailyStats usa dados first-party no Postgres)
# PLAUSIBLE_API_KEY=
# PLAUSIBLE_SITE_ID=catechis.app
# PLAUSIBLE_BASE_URL=https://plausible.io/api
# GOOGLE_ANALYTICS_CLIENT_EMAIL=
# GOOGLE_ANALYTICS_PRIVATE_KEY=
# GOOGLE_ANALYTICS_PROPERTY_ID=

# Resend API (envio de emails transacionais)
RESEND_API_KEY=re_xxxxxxxx

# Pagamentos legacy (obrigatório no boot — Stripe é o provedor ativo)
PAYMENTS_HOBBY_SUBSCRIPTION_PLAN_ID=prod-hobby
PAYMENTS_PRO_SUBSCRIPTION_PLAN_ID=prod-pro
PAYMENTS_CREDITS_10_PLAN_ID=prod-credits
LEMONSQUEEZY_API_KEY=prod-placeholder
LEMONSQUEEZY_STORE_ID=prod-store
LEMONSQUEEZY_WEBHOOK_SECRET=prod-webhook
POLAR_ORGANIZATION_ACCESS_TOKEN=prod-polar-token
POLAR_SANDBOX_MODE=false
POLAR_WEBHOOK_SECRET=prod-polar-webhook
