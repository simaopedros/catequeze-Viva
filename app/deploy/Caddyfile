{
  email admin@catechis.app
}

# Shared reverse_proxy for same-origin /api/* (SSE-friendly: no buffering).
(prod_api) {
  request_body {
    max_size 12MB
  }
  reverse_proxy server:3001 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
    # Flush immediately so Server-Sent Events reach the browser as they are written.
    flush_interval -1
  }
}

# ── Produção: staff portal ────────────────────────────────────────────────────
catechis.app, www.catechis.app {
  @www host www.catechis.app
  redir @www https://catechis.app{uri} permanent

  encode gzip

  handle /auth/* {
    import prod_api
  }

  handle /operations/* {
    import prod_api
  }

  # Same-origin API routes (chat-stream, collaborative-chat-stream, etc.)
  # MUST be before the SPA fallback or Caddy serves index.html as 200.
  handle /api/* {
    import prod_api
  }

  handle /health {
    import prod_api
  }

  handle /readyz {
    import prod_api
  }

  handle /payments-webhook {
    import prod_api
  }

  handle {
    root * /srv/web-app
    try_files {path} /index.html
    file_server
  }
}

# ── Produção: family portal (same SPA build) ─────────────────────────────────
familia.catechis.app {
  encode gzip

  handle /auth/* {
    import prod_api
  }

  handle /operations/* {
    import prod_api
  }

  handle /api/* {
    import prod_api
  }

  handle /health {
    import prod_api
  }

  handle /readyz {
    import prod_api
  }

  handle /payments-webhook {
    import prod_api
  }

  handle {
    root * /srv/web-app
    try_files {path} /index.html
    file_server
  }
}

# ── Produção: API ─────────────────────────────────────────────────────────────
api.catechis.app {
  import prod_api
}
