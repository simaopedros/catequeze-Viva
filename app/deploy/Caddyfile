{
  email admin@catechis.app
  # Only these Cloudflare peers may supply the visitor IP header.
  # Verify against Cloudflare's published IP ranges before deployment.
  servers {
    trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    client_ip_headers CF-Connecting-IP
  }
}

# Shared reverse_proxy for same-origin /api/* (SSE-friendly: no buffering).
(prod_api) {
  request_body {
    max_size 12MB
  }
  reverse_proxy server:3001 {
    header_up Host {host}
    # Collapse the validated visitor address to the one hop Express trusts.
    header_up X-Forwarded-For {client_ip}
    header_up -CF-Connecting-IP
    header_up -X-Real-IP
    header_up X-Forwarded-Proto {scheme}
    # Flush immediately so Server-Sent Events reach the browser as they are written.
    flush_interval -1
  }
}

# Production security headers (staff + family). Do NOT apply on homolog.
(prod_security_headers) {
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  header Content-Security-Policy "frame-ancestors 'none'"
  header X-Content-Type-Options "nosniff"
  header Referrer-Policy "strict-origin-when-cross-origin"
  header X-Frame-Options "DENY"
}

# ── Produção: staff portal ────────────────────────────────────────────────────
catechis.app, www.catechis.app {
  @www host www.catechis.app
  redir @www https://catechis.app{uri} permanent

  encode gzip
  import prod_security_headers

  handle /auth/* {
    import prod_api
  }

  handle /operations/* {
    import prod_api
  }

  # Same-origin API routes (chat-stream, collaborative-chat-stream, etc.)
  # MUST be before the SPA fallback or Caddy serves index.html as 200.
  handle /api/* {
    import prod_api
  }

  # Comunidade share links: the server renders Open Graph tags for crawlers and
  # redirects browsers to the SPA route. Must be proxied, not served by the SPA.
  handle /c/* {
    import prod_api
  }

  handle /comunidade/sitemap.xml {
    import prod_api
  }

  # Blog: sitemap XML and crawler article HTML live on Express, not the SPA.
  handle /blog/sitemap.xml {
    import prod_api
  }
  @blog_crawler {
    path /blog/*
    header_regexp User-Agent (?i)(facebookexternalhit|facebookcatalog|whatsapp|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterest|googlebot|bingbot|applebot|embedly|redditbot|skypeuripreview|vkshare|w3c_validator)
  }
  handle @blog_crawler {
    import prod_api
  }

  handle /health {
    import prod_api
  }

  handle /readyz {
    import prod_api
  }

  handle /payments-webhook {
    import prod_api
  }

  # Hashed Vite assets: missing files must 404 (not SPA index.html as text/html),
  # otherwise open tabs after deploy get "Failed to fetch dynamically imported module".
  # Service worker: nunca deixar edge/navegador servir sw.js antigo.
  handle /sw.js {
    header Cache-Control "no-cache"
    root * /srv/web-app
    file_server
  }

  handle /assets/* {
    root * /srv/web-app
    file_server
  }

  handle {
    root * /srv/web-app
    try_files {path} /index.html
    file_server
  }
}

# ── Produção: family portal (same SPA build) ─────────────────────────────────
familia.catechis.app {
  encode gzip
  import prod_security_headers
  # Private family portal with minors' data — keep out of search indexes.
  header X-Robots-Tag "noindex, nofollow"

  handle /robots.txt {
    header Content-Type "text/plain; charset=utf-8"
    respond `User-agent: *
Disallow: /
` 200
  }

  handle /auth/* {
    import prod_api
  }

  handle /operations/* {
    import prod_api
  }

  handle /api/* {
    import prod_api
  }

  handle /health {
    import prod_api
  }

  handle /readyz {
    import prod_api
  }

  handle /payments-webhook {
    import prod_api
  }

  # Service worker: nunca deixar edge/navegador servir sw.js antigo.
  handle /sw.js {
    header Cache-Control "no-cache"
    root * /srv/web-app
    file_server
  }

  handle /assets/* {
    root * /srv/web-app
    file_server
  }

  handle {
    root * /srv/web-app
    try_files {path} /index.html
    file_server
  }
}

# ── Produção: API ─────────────────────────────────────────────────────────────
api.catechis.app {
  import prod_api
}
