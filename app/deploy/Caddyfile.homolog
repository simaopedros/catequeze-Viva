{
  email admin@catechis.app
  # Escuta :80 e :443. tls internal = cert autoassinado na origem.
  # Cloudflare: use "Full" (não Strict). Ver docs/CLOUDFLARE_SSL.md.
}

(homolog_api) {
  request_body {
    max_size 12MB
  }
  reverse_proxy server:3001 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto https
    # Flush immediately so Server-Sent Events reach the browser as they are written.
    flush_interval -1
    # During `compose up --force-recreate` the Node process is gone for a few
    # seconds. Wait for /health instead of returning an immediate 502.
    health_uri /health
    health_interval 2s
    health_timeout 2s
    fail_duration 5s
    lb_try_duration 8s
    lb_try_interval 500ms
  }
}

homolog.catechis.app {
  tls internal
  encode zstd gzip

  handle /auth/* {
    import homolog_api
  }
  handle /operations/* {
    import homolog_api
  }
  handle /api/* {
    import homolog_api
  }
  # Comunidade share links: server renders Open Graph tags for crawlers.
  handle /c/* {
    import homolog_api
  }
  handle /comunidade/sitemap.xml {
    import homolog_api
  }
  # Blog: sitemap XML and crawler article HTML live on Express, not the SPA.
  handle /blog/sitemap.xml {
    import homolog_api
  }
  @blog_crawler {
    path /blog/*
    header_regexp User-Agent (?i)(facebookexternalhit|facebookcatalog|whatsapp|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterest|googlebot|bingbot|applebot|embedly|redditbot|skypeuripreview|vkshare|w3c_validator)
  }
  handle @blog_crawler {
    import homolog_api
  }
  handle /health {
    import homolog_api
  }
  handle /readyz {
    import homolog_api
  }
  handle /payments-webhook {
    import homolog_api
  }

  # Hashed Vite assets — immutable long cache
  handle /assets/* {
    root * /srv/web-app
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  # Static public assets
  @static path /landing/* /icons/* /brand/* /favicon.svg /favicon.ico /manifest.json /public-banner.webp /sw.js
  handle @static {
    root * /srv/web-app
    header Cache-Control "public, max-age=86400"
    file_server
  }

  handle {
    root * /srv/web-app
    header Cache-Control "public, max-age=0, must-revalidate"
    try_files {path} /index.html
    file_server
  }
}

familia-homolog.catechis.app {
  tls internal
  encode zstd gzip

  handle /auth/* {
    import homolog_api
  }
  handle /operations/* {
    import homolog_api
