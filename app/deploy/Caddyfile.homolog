{
  email admin@catechis.app
  # Escuta :80 e :443. tls internal = cert autoassinado na origem.
  # Cloudflare: use "Full" (não Strict). Ver docs/CLOUDFLARE_SSL.md.
}

(homolog_api) {
  request_body {
    max_size 12MB
  }
  reverse_proxy server:3001 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto https
    # Flush immediately so Server-Sent Events reach the browser as they are written.
    flush_interval -1
  }
}

homolog.catechis.app {
  tls internal
  encode gzip

  handle /auth/* {
    import homolog_api
  }
  handle /operations/* {
    import homolog_api
  }
  handle /api/* {
    import homolog_api
  }
  handle /health {
    import homolog_api
  }
  handle /readyz {
    import homolog_api
  }
  handle /payments-webhook {
    import homolog_api
  }

  handle {
    root * /srv/web-app
    try_files {path} /index.html
    file_server
  }
}

familia-homolog.catechis.app {
  tls internal
  encode gzip

  handle /auth/* {
    import homolog_api
  }
  handle /operations/* {
    import homolog_api
  }
  handle /api/* {
    import homolog_api
  }
  handle /health {
    import homolog_api
  }
  handle /readyz {
    import homolog_api
  }
  handle /payments-webhook {
    import homolog_api
  }

  handle {
    root * /srv/web-app
    try_files {path} /index.html
    file_server
  }
}

api-homolog.catechis.app {
  tls internal
  import homolog_api
}
