{
  email admin@catechis.app
  # Homolog atrás do Cloudflare: use SSL "Flexible" (CF→origem HTTP :80).
  # Para "Full (strict)": monte certs/ com Cloudflare Origin Certificate (ver docs/CLOUDFLARE_SSL.md).
  auto_https off
}

(homolog_api) {
  request_body {
    max_size 12MB
  }
  reverse_proxy server:3001 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto https
  }
}

http://homolog.catechis.app {
  encode gzip

  handle /auth/* {
    import homolog_api
  }
  handle /operations/* {
    import homolog_api
  }
  handle /api/* {
    import homolog_api
  }
  handle /health {
    import homolog_api
  }
  handle /payments-webhook {
    import homolog_api
  }

  handle {
    root * /srv/web-app
    try_files {path} /index.html
    file_server
  }
}

http://familia.homolog.catechis.app {
  encode gzip

  handle /auth/* {
    import homolog_api
  }
  handle /operations/* {
    import homolog_api
  }
  handle /api/* {
    import homolog_api
  }
  handle /health {
    import homolog_api
  }
  handle /payments-webhook {
    import homolog_api
  }

  handle {
    root * /srv/web-app
    try_files {path} /index.html
    file_server
  }
}

http://api.homolog.catechis.app {
  import homolog_api
}
