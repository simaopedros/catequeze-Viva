# Based on Wasp-generated Dockerfile (wasp build output)
# Build context: app/ directory

FROM node:22.22.2-alpine3.23 AS base
RUN apk --no-cache -U upgrade
RUN apk add --no-cache openssl

FROM base AS builder
RUN apk add --no-cache python3 build-base libtool autoconf automake

# Install Wasp CLI
RUN npm install -g @wasp.sh/wasp-cli@0.22.0 @wasp.sh/wasp-cli-linux-x64-musl@0.22.0

WORKDIR /app
COPY . .

ARG DATABASE_URL
ENV DATABASE_URL=${DATABASE_URL}

# Client env baked in at wasp build time (override per environment in CI)
ARG REACT_APP_FAMILY_PORTAL_HOST=familia.homolog.catechis.app
ARG REACT_APP_STAFF_PORTAL_HOST=homolog.catechis.app
ENV REACT_APP_FAMILY_PORTAL_HOST=${REACT_APP_FAMILY_PORTAL_HOST}
ENV REACT_APP_STAFF_PORTAL_HOST=${REACT_APP_STAFF_PORTAL_HOST}

RUN wasp build

# Build server (Prisma generate + Rollup bundle)
WORKDIR /app/.wasp/out/server
RUN npm install && npx prisma generate --schema='../db/schema.prisma' && npm run bundle

FROM base AS runner
RUN apk add --no-cache python3
ENV NODE_ENV=production
WORKDIR /app

# Copy server
COPY --from=builder /app/.wasp/out/server/node_modules .wasp/out/server/node_modules
COPY --from=builder /app/.wasp/out/server/bundle .wasp/out/server/bundle
COPY --from=builder /app/.wasp/out/server/package*.json .wasp/out/server/
COPY --from=builder /app/.wasp/out/db .wasp/out/db
COPY --from=builder /app/node_modules ./node_modules

# Copy web-app (wasp build outputs client to .wasp/build/web-app)
COPY --from=builder /app/.wasp/build/web-app ./web-app

EXPOSE 3001
WORKDIR /app/.wasp/out/server
ENTRYPOINT ["npm", "run", "start-production"]
