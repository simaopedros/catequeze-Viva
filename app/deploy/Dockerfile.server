# Dockerfile for Wasp server + worker (same image, RUN_JOBS differs per service).
# Build context: app/ directory (where main.wasp lives).
#
# Usage:
#   docker build -f deploy/Dockerfile.server --build-arg DATABASE_URL=... -t catechis-server .

FROM node:22-bookworm-slim AS builder

RUN npm install -g @wasp.sh/wasp-cli@0.22.0 @wasp.sh/wasp-cli-linux-x64-glibc@0.22.0

WORKDIR /app
COPY . .

ARG DATABASE_URL
ENV DATABASE_URL=${DATABASE_URL}

RUN wasp build

FROM node:22-bookworm-slim AS runner

WORKDIR /app

COPY --from=builder /app/.wasp/out/server /app/server
COPY --from=builder /app/.wasp/out/web-app /app/web-app

WORKDIR /app/server
RUN npm install --omit=dev

ENV NODE_ENV=production
EXPOSE 3001

CMD ["node", "bundle/server.js"]
