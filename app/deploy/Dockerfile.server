# Based on Wasp-generated Dockerfile (wasp build output)
# Build context: app/ directory

FROM node:22.22.2-alpine3.23 AS base
RUN apk --no-cache -U upgrade
RUN apk add --no-cache openssl

FROM base AS builder
RUN apk add --no-cache python3 build-base libtool autoconf automake

# Install Wasp CLI
RUN npm install -g @wasp.sh/wasp-cli@0.22.0 @wasp.sh/wasp-cli-linux-x64-musl@0.22.0

WORKDIR /app
COPY . .

ARG DATABASE_URL
ENV DATABASE_URL=${DATABASE_URL}

# Client env baked in at vite build time (override per environment in CI)
ARG REACT_APP_API_URL=https://api-homolog.catechis.app
ARG REACT_APP_FAMILY_PORTAL_HOST=familia-homolog.catechis.app
ARG REACT_APP_STAFF_PORTAL_HOST=homolog.catechis.app
ENV REACT_APP_API_URL=${REACT_APP_API_URL}
ENV REACT_APP_FAMILY_PORTAL_HOST=${REACT_APP_FAMILY_PORTAL_HOST}
ENV REACT_APP_STAFF_PORTAL_HOST=${REACT_APP_STAFF_PORTAL_HOST}

RUN wasp build

# Patch generated Wasp SDK for RUN_JOBS + PG_BOSS_NEW_OPTIONS merge
RUN node scripts/patch-wasp-build.mjs

# Wasp build leaves only migration_lock.toml — copy full migration history for deploy
RUN mkdir -p .wasp/out/db/migrations && cp -a migrations/. .wasp/out/db/migrations/

# Build server (Prisma generate + Rollup bundle)
WORKDIR /app/.wasp/out/server
RUN npm install && npx prisma generate --schema='../db/schema.prisma' && npm run bundle

# Build client (Wasp 0.22: vite runs from project root → .wasp/out/web-app/build)
WORKDIR /app
RUN npx vite build

FROM base AS runner
RUN apk add --no-cache python3
ENV NODE_ENV=production
WORKDIR /app

# Copy server
COPY --from=builder /app/.wasp/out/server/node_modules .wasp/out/server/node_modules
COPY --from=builder /app/.wasp/out/server/bundle .wasp/out/server/bundle
COPY --from=builder /app/.wasp/out/server/package*.json .wasp/out/server/
COPY --from=builder /app/.wasp/out/db .wasp/out/db
COPY --from=builder /app/node_modules ./node_modules

# Copy seed scripts and data for runSeed.mjs
COPY --from=builder /app/src/server/scripts ./src/server/scripts

# Copy web-app static assets (Wasp 0.22 vite output)
COPY --from=builder /app/.wasp/out/web-app/build ./web-app

EXPOSE 3001
WORKDIR /app/.wasp/out/server
ENTRYPOINT ["npm", "run", "start-production"]
