route AccountRoute { path: "/account", to: AccountPage }
page AccountPage {
  authRequired: true,
  component: import Account from "@src/user/AccountPage"
}


route AppEditCatechumenRoute { path: "/app/catechumens/:id/edit", to: AppEditCatechumenPage }
page AppEditCatechumenPage { authRequired: true, component: import EditCatechumenPage from "@src/catequese/pages/EditCatechumenPage" }


route AppEditContentRoute { path: "/app/content-library/:id/edit", to: AppEditContentPage }
page AppEditContentPage { authRequired: true, component: import EditContentPage from "@src/catequese/pages/EditContentPage" }

route AppPrintContentRoute { path: "/app/content-library/:id/print", to: AppPrintContentPage }
page AppPrintContentPage { authRequired: true, component: import ContentPrintPage from "@src/catequese/pages/ContentPrintPage" }

route NotFoundRoute { path: "*", to: NotFoundPage }
page NotFoundPage {
  component: import { NotFoundPage } from "@src/client/components/NotFoundPage"
}
//#endregion

//#region Contact Form Messages
route AdminDiocesesRoute { path: "/admin/dioceses", to: AdminDiocesesPage }
page AdminDiocesesPage { authRequired: true, component: import AdminDiocesesPage from "@src/catequese/pages/AdminDiocesesPage" }
//#endregion

//#region Public Upload Docs
route PublicUploadDocsRoute { path: "/upload-docs/:token", to: PublicUploadDocsPage }
page PublicUploadDocsPage {
  authRequired: false,
  component: import PublicUploadDocsPage from "@src/catequese/pages/PublicUploadDocsPage"
}
//#endregion




