//#region Catequese Viva - User Context & Parishes
query getCurrentUserContext {
  fn: import { getCurrentUserContext } from "@src/server/operations/userContext",
  entities: [User, Membership, Parish, Community, PendingInvitation]
}

// Shell bootstrap: userContext + workspaces in one round-trip
query getAppBootstrap {
  fn: import { getAppBootstrap } from "@src/server/operations/userContext",
  entities: [User, Membership, Parish, Community, PendingInvitation, TenantBilling, Diocese]
}

query listParishes {
  fn: import { listParishes } from "@src/server/operations/parishOperations",
  entities: [Parish, Membership, TenantBilling, Diocese, User]
}

query listParishesAdmin {
  fn: import { listParishesAdmin } from "@src/server/operations/parishOperations",
  entities: [Parish, Membership, TenantBilling, Diocese, User]
}

query searchParishesForOnboarding {
  fn: import { searchParishesForOnboarding } from "@src/server/operations/parishOperations",
  entities: [Parish, Diocese]
}

