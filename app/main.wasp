}

//#region Auth Pages
route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import Login from "@src/auth/LoginPage"
}

route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import { Signup } from "@src/auth/SignupPage"
}

route RequestPasswordResetRoute { path: "/request-password-reset", to: RequestPasswordResetPage }
page RequestPasswordResetPage {
  component: import { RequestPasswordResetPage } from "@src/auth/email-and-pass/RequestPasswordResetPage",
}

route PasswordResetRoute { path: "/password-reset", to: PasswordResetPage }
page PasswordResetPage {
  component: import { PasswordResetPage } from "@src/auth/email-and-pass/PasswordResetPage",
}

route EmailVerificationRoute { path: "/email-verification", to: EmailVerificationPage }
page EmailVerificationPage {
  component: import { EmailVerificationPage } from "@src/auth/email-and-pass/EmailVerificationPage",
}
//#endregion

//#region Family Portal Routes
route FamilyInviteCodeRoute { path: "/convite", to: FamilyInviteCodePage }
page FamilyInviteCodePage {
  component: import FamilyInviteCodePage from "@src/catequese/pages/family/FamilyInviteCodePage"
}

route InviteAcceptRoute { path: "/convite/:token", to: InviteAcceptPage }
page InviteAcceptPage {
  component: import InviteAcceptPage from "@src/catequese/pages/family/InviteAcceptPage"
}

route FamilyLoginRoute { path: "/entrar", to: FamilyLoginPage }
page FamilyLoginPage {
  component: import FamilyLoginPage from "@src/catequese/pages/family/FamilyLoginPage"
}

route FamilySignupRoute { path: "/criar-conta", to: FamilySignupPage }
page FamilySignupPage {
  component: import FamilySignupPage from "@src/catequese/pages/family/FamilySignupPage"
}
//#endregion

//#region User
//#region Demo AI App
//#region Payment
query getCustomerPortalUrl {
  fn: import { getCustomerPortalUrl } from  "@src/payment/operations",
  entities: [User]
}

query getSubscriptionDetails {
  fn: import { getSubscriptionDetails } from "@src/payment/operations",
  entities: [User]
}

query getPlanCatalog {
  fn: import { getPlanCatalog } from "@src/server/operations/planCatalogOperations",
  entities: [PricingPlan, PricingPlanPrice],
  auth: false
}

action generateCheckoutSession {
  fn: import { generateCheckoutSession } from "@src/payment/operations",
  entities: [User, Parish, Membership, PricingEvent, TrackedEvent, PricingPlan, PricingPlanPrice]
}

action cancelSubscription {
  fn: import { cancelSubscription } from "@src/payment/operations",
  entities: [User, TenantBilling, Diocese, Parish, Membership]
}

action changeSubscriptionPlan {
  fn: import { changeSubscriptionPlan } from "@src/payment/operations",
  entities: [User, PricingPlan, PricingPlanPrice]
}

api paymentsWebhook {
  fn: import { paymentsWebhook } from "@src/payment/webhook",
  entities: [User, UserAiCredits, TenantBilling, Diocese, Parish, Membership, PricingEvent, TrackedEvent, PricingPlan, PricingPlanPrice, EmailMessage, EmailSuppression, EmailPreference],
  middlewareConfigFn: import { paymentsMiddlewareConfigFn } from "@src/payment/webhook",
  httpRoute: (POST, "/payments-webhook")
}
//#endregion

//#region File Upload
//#region Analytics
query getDailyStats {
  fn: import { getDailyStats } from "@src/analytics/operations",
  entities: [User, DailyStats]
}

//#endregion

