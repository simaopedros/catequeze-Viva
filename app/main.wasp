//#region Catequese Viva - Documents
route AppDocumentsRoute { path: "/app/documents", to: AppDocumentsPage }
page AppDocumentsPage {
  authRequired: true,
  component: import DocumentsPage from "@src/catequese/pages/DocumentsPage"
}

query listDocuments {
  fn: import { listDocuments } from "@src/server/operations/documentOperations",
  entities: [Document, Membership, CatechesisClass, ClassEnrollment]
}

action uploadDocument {
  fn: import { uploadDocument } from "@src/server/operations/documentOperations",
