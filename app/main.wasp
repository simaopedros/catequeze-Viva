app OpenSaaS {
  wasp: {
    version: "^0.22.0"
  },

  title: "Catequese Viva",

  head: [
    // Favicon — prefer small SVG; avoid large ICO on critical path
    "<link rel='icon' type='image/svg+xml' href='/favicon.svg' />",
    "<link rel='apple-touch-icon' sizes='180x180' href='/icons/apple-touch-icon.png' />",
    "<meta name='theme-color' content='#071A2D' />",

    "<meta name='viewport' content='width=device-width, initial-scale=1.0, viewport-fit=cover' />",
    "<link rel='manifest' href='/manifest.json' />",
    "<meta name='mobile-web-app-capable' content='yes' />",
    "<meta name='apple-mobile-web-app-capable' content='yes' />",
    "<meta name='apple-mobile-web-app-status-bar-style' content='black-translucent' />",
    "<meta name='apple-mobile-web-app-title' content='Catequese Viva' />",

    // Fonts: preconnect + preloaded stylesheet. The <link> is `as='style'` so it
    // does not block first paint; src/client/fonts.ts promotes it to a
    // stylesheet right after hydration (display=swap keeps text visible).
    // Note: head tags are converted to React; use camelCase attrs Wasp/React accept.
    "<link rel='preconnect' href='https://fonts.googleapis.com' />",
    "<link rel='preconnect' href='https://fonts.gstatic.com' crossOrigin='anonymous' />",
    "<link rel='preload' as='style' data-font-stylesheet='true' href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600;700&display=swap' />",

    // LCP hero: real Painel screenshot, discovered before JS hydrates
    "<link rel='preload' as='image' type='image/webp' imageSrcSet='/landing/dashboard-hero-960.webp 960w, /landing/dashboard-hero.webp 1600w' imageSizes='(max-width: 1024px) 100vw, 900px' fetchPriority='high' />",

    "<meta name='description' content='Mais presença no encontro, menos tempo organizando. Prepare encontros, acompanhe catequizandos e registre presenças. 7 dias grátis, sem cartão.' />",
    "<meta name='author' content='Catequese Viva' />",
    "<meta name='keywords' content='catequese, católica, paróquia, pastoral, crisma, primeira eucaristia, igreja, gestão paroquial' />",

    "<meta property='og:type' content='website' />",
    "<meta property='og:title' content='Você semeia a fé. A gente organiza a turma. | Catequese Viva' />",
    "<meta property='og:site_name' content='Catequese Viva' />",
    "<meta property='og:url' content='https://catechis.app' />",
    "<meta property='og:description' content='Mais presença no encontro, menos tempo organizando. Prepare encontros, acompanhe catequizandos e registre presenças. 7 dias grátis, sem cartão.' />",
    "<meta property='og:image' content='https://catechis.app/public-banner.webp' />",
    "<meta property='og:image:width' content='1200' />",
    "<meta property='og:image:height' content='630' />",
    "<meta name='twitter:card' content='summary_large_image' />",
    "<meta name='twitter:title' content='Você semeia a fé. A gente organiza a turma. | Catequese Viva' />",
    "<meta name='twitter:description' content='Mais presença no encontro, menos tempo organizando. Prepare encontros, acompanhe catequizandos e registre presenças. 7 dias grátis, sem cartão.' />",
    "<meta name='twitter:image' content='https://catechis.app/public-banner.webp' />",
  ],

  // 🔐 Auth out of the box! https://wasp.sh/docs/auth/overview
  auth: {
    userEntity: User,
    methods: {
      // NOTE: If you decide to not use email auth, make sure to also delete the related routes and pages below.
      //   (RequestPasswordReset(Route|Page), PasswordReset(Route|Page), EmailVerification(Route|Page))
      email: {
        fromField: {
          name: "Catequese Viva",
          email: "onboarding@catechis.app"
        },
        emailVerification: {
          clientRoute: EmailVerificationRoute,
          getEmailContentFn: import { getVerificationEmailContent } from "@src/auth/email-and-pass/emails",
        },
        passwordReset: {
          clientRoute: PasswordResetRoute,
          getEmailContentFn: import { getPasswordResetEmailContent } from "@src/auth/email-and-pass/emails",
        },
        userSignupFields: import { getEmailUserFields } from "@src/auth/userSignupFields",
      },
      // Google Auth — requires GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET env vars
      google: {
        userSignupFields: import { getGoogleUserFields } from "@src/auth/userSignupFields",
        configFn: import { getGoogleAuthConfig } from "@src/auth/userSignupFields",
      },
      // Uncomment to enable GitHub Auth (check https://wasp.sh/docs/auth/social-auth/github for setup instructions):
      // gitHub: {
      //   userSignupFields: import { getGitHubUserFields } from "@src/auth/userSignupFields",
      //   configFn: import { getGitHubAuthConfig } from "@src/auth/userSignupFields",
      // },
      // Uncomment to enable Discord Auth (check https://wasp.sh/docs/auth/social-auth/discord for setup instructions):
      // discord: {
      //   userSignupFields: import { getDiscordUserFields } from "@src/auth/userSignupFields",
      //   configFn: import { getDiscordAuthConfig } from "@src/auth/userSignupFields"
      // }
    },
    onAuthFailedRedirectTo: "/login",
    onAuthSucceededRedirectTo: "/app",
    onAfterSignup: import { onAfterSignup } from "@src/auth/hooks",
  },

  client: {
    rootComponent: import App from "@src/client/App",
  },

  server: {
    envValidationSchema: import { serverEnvValidationSchema } from "@src/env",
    setupFn: import { serverSetup } from "@src/server/setup",
  },

  emailSender: {
    provider: SMTP,
    defaultFrom: {
      name: "Catequese Viva",
      email: "noreply@catechis.app"
    },
  },

  db: {
    seeds: [
      import { seedPricingCatalog } from "@src/server/scripts/seedPricingCatalog",
      import { seedSocialTopics } from "@src/server/scripts/seedSocialTopics"
    ]
  },
}

route LandingPageRoute { path: "/", to: LandingPage }
page LandingPage {
  component: import LandingPage from "@src/landing-page/LandingPage"
}

route CheckoutThankYouRoute { path: "/obrigado", to: CheckoutThankYouPage }
page CheckoutThankYouPage {
  component: import CheckoutResultPage from "@src/payment/CheckoutResultPage"
}

// Google Ads landing pages
route IaLandingPageRoute { path: "/ia", to: IaLandingPage }
page IaLandingPage {
  component: import LandingIa from "@src/landing-page/LandingIa"
}

route PresencaLandingPageRoute { path: "/presenca", to: PresencaLandingPage }
page PresencaLandingPage {
  component: import LandingPresenca from "@src/landing-page/LandingPresenca"
}

route SistemaLandingPageRoute { path: "/sistema", to: SistemaLandingPage }
page SistemaLandingPage {
