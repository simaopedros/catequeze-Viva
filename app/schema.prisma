  totalViews                Int    @default(0)
  prevDayViewsChangePercent String @default("0")
  userCount                 Int    @default(0)
  paidUserCount             Int    @default(0)
  userDelta                 Int    @default(0)
  paidUserDelta             Int    @default(0)
  totalRevenue              Float  @default(0)
  totalProfit               Float  @default(0)

  sources PageViewSource[]
}

model PageViewSource {
  name String
  date DateTime @default(now())

  dailyStats   DailyStats? @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId Int?

  visitors Int

  @@id([date, name])
}

model Logs {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  message String
  level   String
}

model ContactFormMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  name    String?
  email   String?
  content String
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  replyBody String?
}

// ─── Comunidade (social feed) ─────────────────────────────────────────────────

/// Public post in the global Catholic community feed.
/// Publishing requires an active subscription; reading is open to everyone.
model SocialPost {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Stable shareable identifier used in /comunidade/p/:slug and /c/:slug
  slug String @unique

  authorId String
  author   User   @relation("SocialPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// Optional credit to the workspace the author was acting for
  parishId String?
  parish   Parish? @relation(fields: [parishId], references: [id], onDelete: SetNull)

  kind        SocialPostKind    @default(TEXT)
  status      SocialPostStatus  @default(PUBLISHED)
  videoFormat SocialVideoFormat?

  body   String
  locale String @default("pt-BR")

  publishedAt DateTime?

  /// Author confirmed they hold image-use authorization for people shown in the media
  mediaConsentAckAt DateTime?

  // Denormalised counters kept in sync by the operations layer
  reactionCount Int @default(0)
  commentCount  Int @default(0)
  shareCount    Int @default(0)
  viewCount     Int @default(0)

  // Moderation
  removedAt     DateTime?
  removedById   String?
  removedBy     User?     @relation("SocialPostRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  removalReason String?

  media    SocialMedia[]
  topics   SocialPostTopic[]
  comments SocialComment[]
  reactions SocialReaction[]
  share    SocialShare?
  watches  SocialVideoWatch[]

  @@index([status, publishedAt])
  @@index([authorId, createdAt])
  @@index([parishId])
  @@index([videoFormat, status, publishedAt])
}

/// Image (Bunny Storage) or video (Bunny Stream) attached to a post.
model SocialMedia {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId String?
  post   SocialPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// Owner of the upload — set before the post exists (direct video upload flow)
  uploaderId String

  kind     SocialMediaKind
  position Int             @default(0)
  status   SocialMediaStatus @default(PENDING)

  /// Bunny Storage object key (images)
  storageKey String?

  /// Bunny Stream identifiers (videos)
  bunnyVideoId   String? @unique
  bunnyLibraryId String?

  mimeType        String?
  sizeBytes       Int?
  width           Int?
  height          Int?
  durationSeconds Int?
  thumbnailUrl    String?
  altText         String?

  failureReason String?

  @@index([postId, position])
  @@index([status, createdAt])
  @@index([uploaderId])
}

/// Curated pastoral topic used to organise and filter the feed.
model SocialTopic {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  slug     String  @unique
  name     String
  nameEn   String?
  nameEs   String?
  position Int     @default(0)
  active   Boolean @default(true)

  posts SocialPostTopic[]
}

model SocialPostTopic {
  postId  String
  post    SocialPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  topicId String
  topic   SocialTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([postId, topicId])
  @@index([topicId])
}

model SocialReaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type SocialReactionType @default(AMEM)

  @@unique([postId, userId])
  @@index([userId])
}

model SocialComment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("SocialCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   SocialComment?  @relation("SocialCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  SocialComment[] @relation("SocialCommentThread")

  body   String
  status SocialCommentStatus @default(PUBLISHED)

  removedAt     DateTime?
  removedById   String?
  removedBy     User?     @relation("SocialCommentRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  removalReason String?

  @@index([postId, createdAt])
  @@index([authorId])
}

/// Abuse report on a post or comment. Reporter may be anonymous (IP hash only).
model SocialReport {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  targetType SocialReportTargetType
  targetId   String

  reporterId    String?
  reporter      User?   @relation("SocialReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterIpHash String?

  reason  SocialReportReason @default(OTHER)
  details String?

  status       SocialReportStatus @default(OPEN)
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("SocialReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model SocialFollow {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  followerId String
  follower   User   @relation("SocialFollower", fields: [followerId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("SocialFollowed", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([followerId, authorId])
  @@index([authorId])
}

/// Snapshot of a native share (verse, library document, AI artifact, …).
/// Stored denormalised so the feed card stays stable if the source changes.
model SocialShare {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  postId String     @unique
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  kind SocialShareKind

  title       String
  subtitle    String?
  excerpt     String
  href        String
  sourceId    String?
  sourceLabel String?

  @@index([kind, sourceId])
}

model SocialBlock {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("SocialBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("SocialBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Watch / completion signal used by the Rhema "Para você" ranking.
model SocialVideoWatch {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  watchSeconds   Int   @default(0)
  completionRate Float?

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId, updatedAt])
}

// ─── Email platform (provider-agnostic outbox) ───────────────────────────────

enum EmailMessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
  SUPPRESSED
  CANCELLED
}

enum EmailSuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  UNSUBSCRIBE
}

enum EmailTopic {
  LIFECYCLE
  PRODUCT_UPDATES
  PASTORAL_ANNOUNCEMENTS
}

model EmailMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scheduledAt DateTime @default(now())
  sentAt    DateTime?

  messageId         String
  topic             EmailTopic?
  stream            String   @default("transactional")
  to                String
  toHash            String
  userId            String?
  subject           String
  provider          String   @default("resend")
  providerMessageId String?
  status            EmailMessageStatus @default(QUEUED)
  idempotencyKey    String   @unique
  payload           Json
  attempts          Int      @default(0)
  lastError         String?

  @@index([status, scheduledAt])
  @@index([providerMessageId])
  @@index([toHash, messageId])
  @@index([userId, messageId])
}

model EmailSuppression {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  email     String
  emailHash String
  reason    EmailSuppressionReason
  source    String

  @@unique([emailHash, reason])
  @@index([emailHash])
}

model EmailPreference {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email      String
  topic      EmailTopic
  optedOutAt DateTime?

  @@unique([email, topic])
  @@index([userId])
}

// ─── Hierarchical pastoral resources ──────────────────────────────────────────

model OfficialResource {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  summary     String?
  body        String?
  fileUrl     String?
  fileName    String?
  kind        OfficialResourceKind   @default(OTHER)
  status      OfficialResourceStatus @default(DRAFT)
  stageKey    String?
  locale      String                 @default("pt-BR")
  version     Int                    @default(1)
  validFrom   DateTime?
  validUntil  DateTime?

  ownerType         ResourceOwnerType @default(DIOCESE)
  inheritancePolicy InheritancePolicy @default(LOCKED)

  dioceseId String?
  diocese   Diocese? @relation(fields: [dioceseId], references: [id])

  parishId String?
  parish   Parish? @relation(fields: [parishId], references: [id])

  communityId String?
  community   Community? @relation(fields: [communityId], references: [id])

  classId String?
  class   CatechesisClass? @relation(fields: [classId], references: [id])

  createdById String?
  createdBy   User?   @relation("OfficialResourceCreator", fields: [createdById], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("OfficialResourceReviewer", fields: [reviewedById], references: [id])

  sourceResourceId String?
  sourceResource   OfficialResource?  @relation("OfficialResourceInheritance", fields: [sourceResourceId], references: [id])
  adaptedCopies    OfficialResource[] @relation("OfficialResourceInheritance")

  adoptions    OfficialResourceAdoption[]
  attachments  OfficialResourceAttachment[]

  @@index([dioceseId, status])
  @@index([parishId, status])
  @@index([kind, status])
  @@index([sourceResourceId])
}

model OfficialResourceAttachment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name      String
  mimeType  String?
  s3Key     String
  sizeBytes Int?

  resourceId String
  resource   OfficialResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation("OfficialResourceAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([resourceId])
  @@index([s3Key])
}

model OfficialResourceAdoption {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resourceId String
  resource   OfficialResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  adopterType ResourceOwnerType
  adopterId   String
  status      AdoptionStatus @default(INHERITED)
  adaptedCopyId String?
  sourceVersion Int?
  copiedVersion Int?

  @@unique([resourceId, adopterType, adopterId])
  @@index([adopterType, adopterId])
}

model PastoralAnnouncement {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  body        String
  status      PastoralAnnouncementStatus @default(DRAFT)
  audience    String                     @default("coordinators")
  requireAck  Boolean                    @default(true)
  publishedAt DateTime?

  ownerType         ResourceOwnerType @default(DIOCESE)
  inheritancePolicy InheritancePolicy @default(REQUIRED_EXTENDABLE)

  dioceseId String?
  diocese   Diocese? @relation(fields: [dioceseId], references: [id])

  parishId String?
  parish   Parish? @relation(fields: [parishId], references: [id])

  communityId String?
  community   Community? @relation(fields: [communityId], references: [id])

  classId String?
  class   CatechesisClass? @relation(fields: [classId], references: [id])

  sourceAnnouncementId String?
  sourceAnnouncement   PastoralAnnouncement?  @relation("AnnouncementCascade", fields: [sourceAnnouncementId], references: [id])
  republishedCopies    PastoralAnnouncement[] @relation("AnnouncementCascade")

  createdById String?
  createdBy   User?   @relation("AnnouncementCreator", fields: [createdById], references: [id])

  acknowledgements PastoralAnnouncementAck[]

  @@index([dioceseId, status])
  @@index([parishId, status])
  @@index([publishedAt])
}

model PastoralAnnouncementAck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  announcementId String
  announcement   PastoralAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  readAt DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

model CatecheticalItinerary {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name              String
  description       String?
  locale            String              @default("pt-BR")
  status            OfficialResourceStatus @default(DRAFT)
  minDurationWeeks  Int?
  ownerType         ResourceOwnerType   @default(DIOCESE)
  inheritancePolicy InheritancePolicy   @default(REQUIRED_EXTENDABLE)

  dioceseId String?
  diocese   Diocese? @relation(fields: [dioceseId], references: [id])

  parishId String?
  parish   Parish? @relation(fields: [parishId], references: [id])

  createdById String?
  createdBy   User?   @relation("ItineraryCreator", fields: [createdById], references: [id])

  stages CatecheticalItineraryStage[]
  years  CatecheticalYear[]

  @@index([dioceseId, status])
  @@index([parishId])
}

model CatecheticalItineraryStage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?
  order       Int     @default(0)
  minAge      Int?
  durationWeeks Int?

  itineraryId String
  itinerary   CatecheticalItinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId, order])
}

model FormationTrack {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?
  kind        FormationTrackKind @default(INITIAL)
  hours       Int?
  locale      String             @default("pt-BR")
  active      Boolean            @default(true)

  ownerType         ResourceOwnerType @default(DIOCESE)
  inheritancePolicy InheritancePolicy @default(SUGGESTED)

  dioceseId String?
  diocese   Diocese? @relation(fields: [dioceseId], references: [id])

  parishId String?
  parish   Parish? @relation(fields: [parishId], references: [id])

  createdById String?
  createdBy   User?   @relation("FormationTrackCreator", fields: [createdById], references: [id])

  sessions    FormationSession[]
  enrollments FormationEnrollment[]
  modules     FormationModule[]

  @@index([dioceseId, active])
  @@index([parishId])
}

model FormationModule {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  order       Int     @default(0)

  trackId String
  track   FormationTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  lessons FormationLesson[]

  @@index([trackId, order])
}

model FormationLesson {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title           String
  body            String?
  durationMinutes Int?
  videoUrl        String?
  resourceUrl     String?
  order           Int     @default(0)

  moduleId String
  module   FormationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  progress FormationLessonProgress[]

  @@index([moduleId, order])
}

model FormationLessonProgress {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  completedAt DateTime @default(now())

  lessonId String
  lesson   FormationLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([userId])
}

model FormationSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  hours       Int?
  notes       String?

  trackId String
  track   FormationTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  attendances FormationAttendance[]

  @@index([trackId, startsAt])
}

model FormationEnrollment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status      FormationEnrollmentStatus @default(ENROLLED)
  completedAt DateTime?
  hoursDone   Int                       @default(0)

  trackId String
  track   FormationTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([trackId, userId])
  @@index([userId])
}

model FormationAttendance {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  present Boolean @default(true)

  sessionId String
  session   FormationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  recordedById String?
  recordedBy   User?   @relation("FormationAttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([sessionId, userId])
}

model ResourceAdoption {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resourceKind String
  sourceId     String
  adopterType  ResourceOwnerType
  adopterId    String
  status       AdoptionStatus @default(INHERITED)
  adaptedCopyId String?
  sourceVersion Int?
  copiedVersion Int?

  adoptedById String?
  adoptedBy   User?   @relation(fields: [adoptedById], references: [id])

  @@unique([resourceKind, sourceId, adopterType, adopterId])
  @@index([adopterType, adopterId])
  @@index([resourceKind, sourceId])
}

/// Public marketing/educational articles authored by platform admins.
model BlogPost {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title           String
  slug            String          @unique
  excerpt         String          @default("")
  bodyHtml        String          @default("")
  coverImageKey   String?
  category        BlogCategory
  tags            String[]        @default([])
  locale          String          @default("pt-BR")
  status          BlogPostStatus  @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?

  authorId String
  author   User   @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt])
  @@index([locale, status])
}



