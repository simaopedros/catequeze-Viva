---
import StarlightThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import type { Props } from "@astrojs/starlight/props";
---

{
  /* Light-only product: keep the Starlight control mounted but hidden. */
}
<div class="theme-select-hidden">
  <StarlightThemeSelect {...Astro.props}>
    <slot />
  </StarlightThemeSelect>
</div>

<style>
  .theme-select-hidden {
    display: none;
  }
</style>
