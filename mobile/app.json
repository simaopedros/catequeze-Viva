{
  "expo": {
    "name": "Catequese Viva",
    "slug": "catequis",
    "scheme": "catequis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071d36"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.catechis.mobile",
      "associatedDomains": ["applinks:catechis.app"],
      "infoPlist": {
        "NSCameraUsageDescription": "A câmara é usada para fotografar e partilhar imagens com a Comunidade.",
        "NSPhotoLibraryUsageDescription": "A biblioteca de fotos é usada para escolher imagens e vídeos para partilhar com a Comunidade e como foto de perfil."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071d36"
      },
      "package": "app.catechis.mobile",
      "permissions": ["POST_NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "catequis" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "catechis.app", "pathPrefix": "/c" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "A biblioteca de fotos é usada para escolher imagens e vídeos para partilhar com a Comunidade e como foto de perfil."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
